[{"y0": 0.04505813957761573, "y1": 0.06250000012338097, "x0": 0.17857142910894103, "x1": 0.25751879532714916, "t": "GATE"}, {"y0": 0.0465116280750707, "y1": 0.06249999995303002, "x0": 0.2875939907261634, "x1": 0.7180450998440121, "t": "Graduate Aptitude Test in Engineering 2021"}, {"y0": 0.061046511660256875, "y1": 0.07848837220602212, "x0": 0.18045112634884372, "x1": 0.25751879749984047, "t": "2021"}, {"y0": 0.06540697689532271, "y1": 0.08139534877328203, "x0": 0.33458646282362187, "x1": 0.659774432928258, "t": "Organising Institute - IIT Bombay"}, {"y0": 0.09011627895676855, "y1": 0.10755813950253379, "x0": 0.33082708907953057, "x1": 0.8496240517099432, "t": "Computer Science and Information Technology (CS, Set-2)"}, {"y0": 0.14389534897631873, "y1": 0.158430232186472, "x0": 0.16353383491745002, "x1": 0.20112781996976806, "t": "Q.28"}, {"y0": 0.1436363635905722, "y1": 0.15697674371012715, "x0": 0.234962411310779, "x1": 0.8364661721478676, "t": "Suppose we want to design a synchronous circuit that processes a string of O's"}, {"y0": 0.15818181793549768, "y1": 0.17296511596554176, "x0": 0.234962411310779, "x1": 0.8364661721478676, "t": "and I's. Given a string, it produces another string by replacing the first 1 in any"}, {"y0": 0.17441860490655126, "y1": 0.18909090911779214, "x0": 0.23496242871925724, "x1": 0.7556390923960303, "t": "subsequence of consecutive 1's by a 0. Consider the following example."}, {"y0": 0.2034883722515125, "y1": 0.2181818179773869, "x0": 0.390977453468657, "x1": 0.680451127609037, "t": "Input sequence: 00100011000011100"}, {"y0": 0.21939393931978535, "y1": 0.23401162746990223, "x0": 0.3890977485203515, "x1": 0.6804511237070923, "t": "Output sequence: 00000001000001100"}, {"y0": 0.24848484853314756, "y1": 0.26181818186648087, "x0": 0.234962411310779, "x1": 0.8364661721478676, "t": "A Mealy Machine is a state machine where both the next state and the output are"}, {"y0": 0.2642424240247021, "y1": 0.27761627869074734, "x0": 0.23496241945048063, "x1": 0.6203007512888672, "t": "functions of the present state and the current input."}, {"y0": 0.280523256144524, "y1": 0.29360465068687125, "x0": 0.234962411310779, "x1": 0.8364661721478676, "t": "The above mentioned circuit can be designed as a two-state Mealy machine. The"}, {"y0": 0.2963636364791429, "y1": 0.3096969698124763, "x0": 0.234962411310779, "x1": 0.8364661721478676, "t": "states in the Mealy machine can be represented using Boolean values 0 and 1. We"}, {"y0": 0.3125000004577507, "y1": 0.3255813950000981, "x0": 0.23496239777694464, "x1": 0.8364661586140333, "t": "denote the current state, the next state, the next incoming bit, and the output bit"}, {"y0": 0.3270348837921251, "y1": 0.3430303030342903, "x0": 0.23308272506888045, "x1": 0.7030075083271093, "t": "of the Mealy machine by the variables s, t, b and y respectively."}, {"y0": 0.34302325606934203, "y1": 0.3575757574010181, "x0": 0.2330827100767557, "x1": 0.6090225605999361, "t": "Assume the initial state of the Mealy machine is 0."}, {"y0": 0.36606060626037285, "y1": 0.3824242426240092, "x0": 0.23308270813899207, "x1": 0.8214285616515558, "t": "What are the Boolean expressions corresponding to t and y in terms of s and b?"}, {"y0": 0.4113372093250707, "y1": 0.42732558120303, "x0": 0.18984962398927102, "x1": 0.22180451188165629, "t": "(A)"}, {"y0": 0.41133720948754726, "y1": 0.4244186040298945, "x0": 0.23308270816110435, "x1": 0.3007518800594469, "t": "t=s +b"}, {"y0": 0.4281237909200628, "y1": 0.442503830944329, "x0": 0.23394551919590048, "x1": 0.2869006563470626, "t": "y = sb"}, {"y0": 0.47238372087788094, "y1": 0.48837209275584015, "x0": 0.18984962366658933, "x1": 0.2218045115589746, "t": "(B)"}, {"y0": 0.47383720913009375, "y1": 0.48546511616060406, "x0": 0.23308270819525043, "x1": 0.27443608936114056, "t": "t =b"}, {"y0": 0.48907988714318673, "y1": 0.5055789487276594, "x0": 0.23351594627819178, "x1": 0.28748567929817304, "t": "y = sb"}, {"y0": 0.5363372094850397, "y1": 0.550872092695193, "x0": 0.18984962499804034, "x1": 0.2199248118440649, "t": "(C)"}, {"y0": 0.5363372093626518, "y1": 0.547965116393162, "x0": 0.23120300825164142, "x1": 0.2725563894175315, "t": "t = b"}, {"y0": 0.5959302325904894, "y1": 0.6133720931362547, "x0": 0.18796992478857225, "x1": 0.22180451073774354, "t": "(D)"}, {"y0": 0.5973837212026636, "y1": 0.6104651157450108, "x0": 0.23120300764418966, "x1": 0.30075188058889296, "t": "t = s+b"}, {"y0": 0.9460606063387398, "y1": 0.9593939396720731, "x0": 0.15601504321114243, "x1": 0.39849623902569964, "t": "CS, Set-2 - Copyright \u00a9 GATE 2021"}, {"y0": 0.9460606059207242, "y1": 0.9578488371635109, "x0": 0.7537593995586626, "x1": 0.8477443621894576, "t": "Page 24 of 43"}]