[{"y0": 0.04348867097078302, "y1": 0.05534853818232721, "x0": 0.12214649451318679, "x1": 0.18800388252228506, "t": "GATE 2019"}, {"y0": 0.04360465119292112, "y1": 0.05393939376790191, "x0": 0.5695488750050143, "x1": 0.8458646657374667, "t": "Computer Science and Information Technology Set-2"}, {"y0": 0.06666666666489884, "y1": 0.0830303030285352, "x0": 0.14097744848150476, "x1": 0.5827067638775177, "t": "Q.6 Which one of the following is NOT a valid identity?"}, {"y0": 0.10000000009267618, "y1": 0.11636363645631265, "x0": 0.20864662296363828, "x1": 0.44360901459275276, "t": "(A)(xy) 0z= x 0 (y\u0110z)"}, {"y0": 0.10000000000546694, "y1": 0.1163636363691033, "x0": 0.5601503740589427, "x1": 0.785714284372851, "t": "(B)(x+y) @z= x\u00a9 (y+z)"}, {"y0": 0.11757575734614234, "y1": 0.1339393937097787, "x0": 0.20864662300562423, "x1": 0.42293232704136824, "t": "(C)x 0y = x + y, if xy = 0"}, {"y0": 0.11757575745947846, "y1": 0.13226744148879754, "x0": 0.5601503793554152, "x1": 0.744360902524284, "t": "(D) x*y = (xy+ xy)"}, {"y0": 0.1581818184503273, "y1": 0.1758720932379989, "x0": 0.1409774518890742, "x1": 0.8740601424718281, "t": "Q.7 If L is a regular language over & = {a, b), which one of the following languages is NOT"}, {"y0": 0.17560959832429968, "y1": 0.1906694717318369, "x0": 0.19163911835653102, "x1": 0.2613684001736414, "t": "regular?"}, {"y0": 0.20639534857886155, "y1": 0.2238372091246268, "x0": 0.20864661413847382, "x1": 0.46052631518483456, "t": "(A) L \u2022 L = {xy | x EL,yR \u20ac L}"}, {"y0": 0.2236363633570515, "y1": 0.24127907002578963, "x0": 0.21052632006922825, "x1": 0.3552631571394183, "t": "(B) [wwR | wE L}"}, {"y0": 0.23982558113700114, "y1": 0.2572674416827664, "x0": 0.20864661677819854, "x1": 0.6109022580338314, "t": "(C) Prefix (L) = (x \u20ac I*|]y E I* such that xy C L}"}, {"y0": 0.256969697199381, "y1": 0.27333333356301737, "x0": 0.2105263164085218, "x1": 0.610902256617794, "t": "(D) Suffix (L) = {y \u20ac [*|]x \u20ac I* such that xy \u20ac L}"}, {"y0": 0.3151515149233305, "y1": 0.3328488370752082, "x0": 0.1409774530920818, "x1": 0.8740601436748354, "t": "Q.8 Consider Z = X - Y, where X, Y and Z are all in sign-magnitude form. X and Y are each"}, {"y0": 0.33272727281338865, "y1": 0.349090909177025, "x0": 0.19172932493669237, "x1": 0.8740601351009019, "t": "represented in n bits. To avoid overflow, the representation of Z would require a minimum"}, {"y0": 0.3836363637787532, "y1": 0.3982558136254255, "x0": 0.2086466198679445, "x1": 0.29135338219972473, "t": "(A) n bits"}, {"y0": 0.3820436791779236, "y1": 0.3984795763114908, "x0": 0.5600980409114253, "x1": 0.6729846670563606, "t": "(B) n - 1 bits"}, {"y0": 0.3997093025082954, "y1": 0.4145454543249236, "x0": 0.20864661734633497, "x1": 0.3214285725032891, "t": "(C) n+ 1 bits"}, {"y0": 0.39970930265364424, "y1": 0.41454545447027247, "x0": 0.5582706742244705, "x1": 0.6729323304277852, "t": "(D) n + 2 bits"}, {"y0": 0.45636363629466103, "y1": 0.4723837210225552, "x0": 0.14097745770328887, "x1": 0.7180451049376884, "t": "Q.9 Let X be a square matrix. Consider the following two statements on X."}, {"y0": 0.4738372093506247, "y1": 0.48401162771332884, "x0": 0.22180451167689672, "x1": 0.23308270674415593, "t": "I."}, {"y0": 0.4738372093238922, "y1": 0.48546511635440237, "x0": 0.2763157915773693, "x1": 0.3928571368687461, "t": "X is invertible."}, {"y0": 0.48619426188733894, "y1": 0.5047380850139296, "x0": 0.22156034268983807, "x1": 0.5059338742107653, "t": "IT Determinant of X is non-zero."}, {"y0": 0.521802325888782, "y1": 0.5377906977667413, "x0": 0.1936090318630728, "x1": 0.4774436028643708, "t": "Which one of the following is TRUE?"}, {"y0": 0.546511627854625, "y1": 0.5624999997325844, "x0": 0.19360902701784072, "x1": 0.45676691042576834, "t": "(A) I implies II; II does not imply I."}, {"y0": 0.5639534885305824, "y1": 0.5787878786506552, "x0": 0.1917293311657104, "x1": 0.454887214573638, "t": "(B) II implies I; I does not imply II."}, {"y0": 0.5799418606332103, "y1": 0.5959302325111696, "x0": 0.191729323252812, "x1": 0.511278190218366, "t": "(C) I does not imply II; II does not imply I."}, {"y0": 0.5944767439276987, "y1": 0.6121212122929922, "x0": 0.1936090302653284, "x1": 0.4774436012666263, "t": "(D) I and II are equivalent statements."}, {"y0": 0.6436363637456634, "y1": 0.6600000001092997, "x0": 0.13909774376002879, "x1": 0.6917293252249338, "t": "Q.10 Let G be an arbitrary group. Consider the following relations on G:"}, {"y0": 0.6757575755777393, "y1": 0.6947674414252402, "x0": 0.2500000066744883, "x1": 0.7424812024890455, "t": "R1: Va, b E G, a Rib if and only if 9g E G such that a = g 1bg"}, {"y0": 0.691860465317129, "y1": 0.7109090908007863, "x0": 0.24812031032704873, "x1": 0.5845864627932518, "t": "R2: Va, b EG, a Rzb if and only if a = b-1"}, {"y0": 0.7266666667799864, "y1": 0.7430303031436227, "x0": 0.19360903973304502, "x1": 0.616541344665451, "t": "Which of the above is/are equivalence relation/relations?"}, {"y0": 0.768895348908404, "y1": 0.7848837207863634, "x0": 0.19172932499670833, "x1": 0.3026315791073017, "t": "(A) R1 and R2"}, {"y0": 0.7687713064500902, "y1": 0.7850077631188284, "x0": 0.3552266667454357, "x1": 0.4455252147592484, "t": "(B) R1 only"}, {"y0": 0.768776087682582, "y1": 0.7850029815988565, "x0": 0.5168836026641945, "x1": 0.6109359443286673, "t": "(C) R2 only"}, {"y0": 0.7688953489135951, "y1": 0.7848837207915543, "x0": 0.6823308301776261, "x1": 0.8533834579802686, "t": "(D) Neither R1 not R2"}, {"y0": 0.9447674415767139, "y1": 0.9578488372750301, "x0": 0.12218045081263754, "x1": 0.1428571428903699, "t": "CS"}, {"y0": 0.9433139536322414, "y1": 0.9593023255102006, "x0": 0.8458646616306776, "x1": 0.8796992475798489, "t": "2/15"}]