[{"y0": 0.04481567742287762, "y1": 0.0627424622850492, "x0": 0.17848298553308406, "x1": 0.2576072389047503, "t": "GATE"}, {"y0": 0.0465116280750707, "y1": 0.06249999995303002, "x0": 0.2875939907261634, "x1": 0.7180450998440121, "t": "Graduate Aptitude Test in Engineering 2021"}, {"y0": 0.061046511660256875, "y1": 0.07848837220602212, "x0": 0.18045112634884372, "x1": 0.25751879749984047, "t": "2021"}, {"y0": 0.06540697689532271, "y1": 0.08139534877328203, "x0": 0.33458646282362187, "x1": 0.659774432928258, "t": "Organising Institute - IIT Bombay"}, {"y0": 0.0901162790839487, "y1": 0.10755813962971406, "x0": 0.3308270563463581, "x1": 0.8477443657636043, "t": "Computer Science and Information Technology (CS, Set-1)"}, {"y0": 0.1424418602055899, "y1": 0.15552325590390614, "x0": 0.16353383485479336, "x1": 0.2011278199071114, "t": "Q.44"}, {"y0": 0.14098837210616366, "y1": 0.1557575759857801, "x0": 0.2368421027080171, "x1": 0.8345864614523842, "t": "A TCP server application is programmed to listen on port number P on host S. A"}, {"y0": 0.15818181828935018, "y1": 0.17030303041056227, "x0": 0.23684211484585807, "x1": 0.6823308323345924, "t": "TCP client is connected to the TCP server over the network."}, {"y0": 0.17441860453707048, "y1": 0.18606060629599275, "x0": 0.23684211143922235, "x1": 0.8364661712299502, "t": "Consider that while the TCP connection was active, the server machine S crashed"}, {"y0": 0.19030303026270579, "y1": 0.2020348837478132, "x0": 0.2349624335444331, "x1": 0.796992472407947, "t": "and rebooted. Assume that the client does not use the TCP keepalive timer."}, {"y0": 0.20484848495305763, "y1": 0.21818181828639094, "x0": 0.2368421159977821, "x1": 0.5939849560573555, "t": "Which of the following behaviors is/are possible?"}, {"y0": 0.2514534884457955, "y1": 0.2659883716559488, "x0": 0.18984962452811555, "x1": 0.2199248113741401, "t": "(A)"}, {"y0": 0.25145348882984386, "y1": 0.2645348833721911, "x0": 0.23496239884242132, "x1": 0.736842099888782, "t": "If the client was waiting to receive a packet, it may wait indefinitely."}, {"y0": 0.2993939395929037, "y1": 0.31272727292623703, "x0": 0.1936090300219322, "x1": 0.6954887310682929, "t": "(B) | The TCP server application on S can listen on P after reboot."}, {"y0": 0.34727272703108136, "y1": 0.3619186046380223, "x0": 0.19172933165599984, "x1": 0.8308270655871078, "t": "(C) | If the client sends a packet after the server reboot, it will receive a RST segment."}, {"y0": 0.3953488373920163, "y1": 0.4098837206021696, "x0": 0.18984962392269833, "x1": 0.2218045118150836, "t": "(D)"}, {"y0": 0.3951515149770768, "y1": 0.40988372091709213, "x0": 0.23496241226627979, "x1": 0.8270676678715648, "t": "If the client sends a packet after the server reboot, it will receive a FIN segment."}, {"y0": 0.5130813957253497, "y1": 0.527616278935503, "x0": 0.1635338344788535, "x1": 0.20112781953117154, "t": "Q.45"}, {"y0": 0.513081395776307, "y1": 0.5261627903186542, "x0": 0.23496239527067916, "x1": 0.8364661561077678, "t": "Consider two hosts P and Q connected through a router R. The maximum transfer"}, {"y0": 0.5290697675519, "y1": 0.5436363636119883, "x0": 0.23496241532080367, "x1": 0.8364661761578922, "t": "unit (MTU) value of the link between P and R is 1500 bytes, and between R and"}, {"y0": 0.5448484845774682, "y1": 0.5595930229713557, "x0": 0.2349624078883123, "x1": 0.3458646619989057, "t": "Q is 820 bytes."}, {"y0": 0.5610465119039717, "y1": 0.574127906446319, "x0": 0.23684211293828256, "x1": 0.8364661727290104, "t": "A TCP segment of size 1400 bytes was transferred from P to Q through R, with IP"}, {"y0": 0.5769696967519747, "y1": 0.590303030085308, "x0": 0.23308269509211024, "x1": 0.8364661569755595, "t": "identification value as 0x1234. Assume that the IP header size is 20 bytes. Further,"}, {"y0": 0.5927272725732096, "y1": 0.6061046506323656, "x0": 0.23496241281453822, "x1": 0.8364661736516269, "t": "the packet is allowed to be fragmented, i.e., Don't Fragment (DF) flag in the IP"}, {"y0": 0.6090116278800938, "y1": 0.620639534910604, "x0": 0.2349624107540671, "x1": 0.4060150385567096, "t": "header is not set by P."}, {"y0": 0.6248484848917685, "y1": 0.6381818182251019, "x0": 0.2368421159445266, "x1": 0.5958646570504607, "t": "Which of the following statements is/are correct?"}, {"y0": 0.6700581395788255, "y1": 0.6860465114567849, "x0": 0.18984962392269833, "x1": 0.2218045118150836, "t": "(A)"}, {"y0": 0.6715116281987025, "y1": 0.6860606061372678, "x0": 0.23120299743547112, "x1": 0.836466160365281, "t": "Two fragments are created at R and the IP datagram size carrying the second"}, {"y0": 0.6872727272942939, "y1": 0.699393939415506, "x0": 0.2349624037254062, "x1": 0.3966165382545439, "t": "fragment is 620 bytes."}, {"y0": 0.7325581397175978, "y1": 0.747093022927751, "x0": 0.19172932405819068, "x1": 0.22180451090421524, "t": "(B)"}, {"y0": 0.7325581395697413, "y1": 0.7485465114477006, "x0": 0.23308271118233545, "x1": 0.8364661730657847, "t": "If the second fragment is lost, R will resend the fragment with the IP identification"}, {"y0": 0.7484848487536785, "y1": 0.7601744186315341, "x0": 0.2349624069874707, "x1": 0.33646616782455924, "t": "value 0x1234."}, {"y0": 0.7906976746860203, "y1": 0.8066860465639796, "x0": 0.1898496240049352, "x1": 0.22180451189732048, "t": "(C)"}, {"y0": 0.7906976745806424, "y1": 0.8066860464586018, "x0": 0.23120300850686837, "x1": 0.81390975888035, "t": "If the second fragment is lost, P is required to resend the whole TCP segment."}, {"y0": 0.8386627908778808, "y1": 0.8546511627558401, "x0": 0.18796992473218127, "x1": 0.22180451068135257, "t": "(D)"}, {"y0": 0.8399999998096322, "y1": 0.8546511625062395, "x0": 0.22932331620738766, "x1": 0.8251879739053941, "t": "TCP destination port can be determined by analysing only the second fragment."}, {"y0": 0.9443944025311642, "y1": 0.9611288529003345, "x0": 0.7499002258839369, "x1": 0.8478441327576817, "t": "Page 35 of 40"}, {"y0": 0.9460606063120072, "y1": 0.9607558137344371, "x0": 0.15225563874059372, "x1": 0.3966165356015116, "t": "CS, Set-1 - Copyright \u00a9 GATE 2021"}]