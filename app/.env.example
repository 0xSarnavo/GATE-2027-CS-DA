# Argon2 hash: `bun run hash-password 'your password'`
APP_PASSWORD_HASH=
# Bearer token for Claude: `openssl rand -hex 32`
API_TOKEN=
# Used to hash session ids: `openssl rand -hex 32`
SESSION_SECRET=
# Volume mount. Dev default: ./.data (app/.data). Production default: /data
DATA_DIR=
PORT=3000
TZ=Asia/Kolkata
BACKUP_KEEP=14
# Optional: PUT the nightly .db to this URL (presigned S3 / bucket)
BACKUP_PUSH_URL=
# Optional: run the seed on boot when the DB has no topics (needs seed/ + data/questions in the image)
SEED_ON_BOOT=
# Content import runs on every boot (idempotent). Set to 0 to disable.
IMPORT_ON_BOOT=
# Dev only: pin today's date for testing (ignored in production)
FAKE_TODAY=
# Escape hatch: allow production start without a Railway volume
ALLOW_EPHEMERAL_DATA=
