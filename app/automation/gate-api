#!/bin/zsh
# gate-api METHOD PATH [JSON_BODY] -> calls the GATE 27 API with the stored token.
# e.g. gate-api GET /plan/today?date=2026-10-07 ; gate-api PATCH /doubts/abc '{"answer_md":"..."}'
source /Users/sarnavo/Development/GATE-2027-CS-DA/.gate27-secrets
M=${1:?method}; P=${2:?path}; B=${3:-}
U=https://gate27-production.up.railway.app/api$P
if [ -n "$B" ]; then
  curl -sS -X "$M" -H "Authorization: Bearer $API_TOKEN" -H "Content-Type: application/json" -H "X-Requested-With: app" --data "$B" "$U"
else
  curl -sS -X "$M" -H "Authorization: Bearer $API_TOKEN" -H "X-Requested-With: app" "$U"
fi
echo
