{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate27/anim/scene.schema.json",
  "title": "Animation scene",
  "description": "Data-driven step animation. Object ids are unique; step ops reference existing ids. Every op accepts a single item or an array.",
  "type": "object",
  "required": [
    "id",
    "objects",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "viewBox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "default": [
        0,
        0,
        360,
        240
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/object"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "tone": {
      "enum": [
        "accent",
        "good",
        "bad",
        "mid",
        "muted"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "ids": {
      "oneOf": [
        {
          "$ref": "#/definitions/id"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      ]
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "cell": {
      "type": [
        "string",
        "number"
      ]
    },
    "cellRef": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/definitions/vec2"
        }
      ]
    },
    "object": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "node"
            },
            "label": {
              "type": "string"
            },
            "r": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "enum": [
                "edge",
                "arrow"
              ]
            },
            "from": {
              "$ref": "#/definitions/id"
            },
            "to": {
              "$ref": "#/definitions/id"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "dash": {
              "type": "boolean"
            }
          },
          "description": "Give from+to (object ids) or x1,y1,x2,y2."
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "w",
            "h"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "box"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "fill": {
              "type": "boolean"
            },
            "dash": {
              "type": "boolean"
            },
            "square": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "kind", "cx", "cy", "r"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "tone": { "$ref": "#/definitions/tone" },
            "kind": { "const": "circle" },
            "cx": { "type": "number" },
            "cy": { "type": "number" },
            "r": { "type": "number", "exclusiveMinimum": 0 },
            "fillOpacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "text"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "anchor": {
              "enum": [
                "start",
                "middle",
                "end"
              ]
            },
            "bold": {
              "type": "boolean"
            },
            "mono": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "tex"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "math"
            },
            "tex": {
              "type": "string"
            },
            "size": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            },
            "anchor": {
              "enum": [
                "start",
                "middle",
                "end"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "cells"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "array"
            },
            "cells": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/cell"
              }
            },
            "cw": {
              "type": "number"
            },
            "ch": {
              "type": "number"
            },
            "dir": {
              "enum": [
                "right",
                "up",
                "down"
              ]
            },
            "indices": {
              "type": "boolean"
            },
            "slots": {
              "type": "integer"
            },
            "label": {
              "type": "string"
            }
          },
          "description": "dir up = stack (y is baseline); right = array/queue."
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "values"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "matrix"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/cell"
                }
              }
            },
            "cw": {
              "type": "number"
            },
            "ch": {
              "type": "number"
            },
            "label": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "rows",
            "cols"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "grid"
            },
            "rows": {
              "type": "integer"
            },
            "cols": {
              "type": "integer"
            },
            "cells": {
              "type": "array"
            },
            "cw": {
              "type": "number"
            },
            "ch": {
              "type": "number"
            },
            "rowLabels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "colLabels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rowTitle": {
              "type": "string"
            },
            "colTitle": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "values"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "bar"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "hideZero": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "axis"
            },
            "unit": {
              "type": "number"
            },
            "xr": {
              "$ref": "#/definitions/vec2"
            },
            "yr": {
              "$ref": "#/definitions/vec2"
            },
            "xlabel": {
              "type": "string"
            },
            "ylabel": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "axis",
            "at"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "point"
            },
            "axis": {
              "$ref": "#/definitions/id"
            },
            "at": {
              "$ref": "#/definitions/vec2"
            },
            "hollow": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "axis",
            "to"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "vector"
            },
            "axis": {
              "$ref": "#/definitions/id"
            },
            "to": {
              "$ref": "#/definitions/vec2"
            },
            "from": {
              "$ref": "#/definitions/vec2"
            },
            "label": {
              "type": "string"
            },
            "dash": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "axis"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "curve"
            },
            "axis": {
              "$ref": "#/definitions/id"
            },
            "fn": {
              "type": "string"
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/vec2"
              }
            },
            "domain": {
              "$ref": "#/definitions/vec2"
            },
            "dash": {
              "type": "boolean"
            }
          },
          "description": "fn or points."
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "root"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "tree"
            },
            "root": {
              "$ref": "#/definitions/treeNode"
            },
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            },
            "r": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "array",
            "index"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "tone": {
              "$ref": "#/definitions/tone"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "pointer"
            },
            "array": {
              "$ref": "#/definitions/id"
            },
            "index": {
              "type": "number"
            },
            "label": {
              "type": "string"
            },
            "side": {
              "enum": [
                "above",
                "below",
                "left",
                "right"
              ]
            }
          }
        }
      ]
    },
    "treeNode": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/treeNode"
          }
        }
      }
    },
    "highlight": {
      "oneOf": [
        {
          "$ref": "#/definitions/id"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/id"
            },
            "cells": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/cellRef"
              }
            },
            "tone": {
              "$ref": "#/definitions/tone"
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "caption"
      ],
      "additionalProperties": false,
      "properties": {
        "caption": {
          "type": "string",
          "description": "Say what to notice. Markdown-lite; $math$ allowed."
        },
        "math": {
          "type": "string",
          "description": "Shown under the caption; $..$ delimited or bare TeX."
        },
        "show": {
          "$ref": "#/definitions/ids"
        },
        "hide": {
          "$ref": "#/definitions/ids"
        },
        "highlight": {
          "description": "This step only.",
          "oneOf": [
            {
              "$ref": "#/definitions/highlight"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/highlight"
              }
            }
          ]
        },
        "dim": {
          "description": "Persists until undim. On array/grid/bar, dims the listed cells (or all); on any other object (box, text, node, edge, math, vector...) dims the whole object to reduced opacity.",
          "oneOf": [
            {
              "$ref": "#/definitions/highlight"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/highlight"
              }
            }
          ]
        },
        "undim": {
          "$ref": "#/definitions/ids"
        },
        "move": {
          "oneOf": [
            {
              "$ref": "#/definitions/move"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/move"
              }
            }
          ]
        },
        "set": {
          "oneOf": [
            {
              "$ref": "#/definitions/set"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/set"
              }
            }
          ]
        },
        "draw": {
          "$ref": "#/definitions/ids"
        },
        "animate": {
          "oneOf": [
            {
              "$ref": "#/definitions/animate"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/animate"
              }
            }
          ]
        },
        "swap": {
          "oneOf": [
            {
              "$ref": "#/definitions/swap"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/swap"
              }
            }
          ]
        },
        "push": {
          "description": "Applied after pop within the same step, so one step can pop two values and push their result.",
          "oneOf": [
            {
              "$ref": "#/definitions/push"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/push"
              }
            }
          ]
        },
        "pop": {
          "description": "Ops in one step apply in the order: set, swap, pop, push. A list of pops runs in listed order, so \"pop a, pop b, push a+b\" works in one step.",
          "oneOf": [
            {
              "$ref": "#/definitions/pop"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/pop"
              }
            }
          ]
        }
      }
    },
    "move": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "index": {
          "type": "number"
        },
        "arc": {
          "type": "object",
          "required": ["cx", "cy"],
          "properties": {
            "cx": { "type": "number" },
            "cy": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "description": "x,y in SVG units (axis units for point/vector); pointers use index. Point moves may use arc {cx,cy} in axis units."
    },
    "set": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "tex": {
          "type": "string"
        },
        "cells": {
          "type": "array"
        },
        "values": {
          "type": "array"
        },
        "tone": {
          "$ref": "#/definitions/tone"
        }
      }
    },
    "animate": {
      "type": "object",
      "required": [
        "id",
        "prop"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "prop": {
          "const": "draw"
        }
      }
    },
    "swap": {
      "type": "object",
      "required": [
        "id",
        "i",
        "j"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "i": {
          "type": "integer"
        },
        "j": {
          "type": "integer"
        }
      }
    },
    "push": {
      "type": "object",
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "value": {
          "$ref": "#/definitions/cell"
        }
      }
    },
    "pop": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "end": {
          "enum": [
            "back",
            "front"
          ]
        }
      }
    }
  }
}
