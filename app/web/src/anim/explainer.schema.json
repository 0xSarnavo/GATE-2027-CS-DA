{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate27/anim/explainer.schema.json",
  "title": "Explainer file (data/explainers/<topic_id>.json)",
  "description": "Each text field has a short Focus version (shown by default; <=3 bullets of <=12 words, one **bold** anchor word each, one formula at most) and an optional <field>_full version (opens on Show more / Full mode).",
  "type": "object",
  "required": [
    "topic_id",
    "cards"
  ],
  "properties": {
    "topic_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what"
        ],
        "properties": {
          "atom_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "what": {
            "type": "string",
            "description": "Markdown-lite with $KaTeX$."
          },
          "what_full": {
            "type": "string",
            "description": "Markdown-lite with $KaTeX$."
          },
          "why": {
            "type": "string",
            "description": "Markdown-lite with $KaTeX$."
          },
          "why_full": {
            "type": "string",
            "description": "Markdown-lite with $KaTeX$."
          },
          "how": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Markdown-lite with $KaTeX$."
            }
          },
          "how_full": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Markdown-lite with $KaTeX$."
            }
          },
          "trap": {
            "type": "string",
            "description": "Markdown-lite with $KaTeX$."
          },
          "trap_full": {
            "type": "string",
            "description": "Markdown-lite with $KaTeX$."
          },
          "scene": {
            "type": "string",
            "description": "id of a scene in this file's scenes[]"
          },
          "try": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "scene.schema.json"
      }
    }
  }
}