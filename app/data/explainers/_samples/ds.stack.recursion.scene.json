{
  "id": "ds.stack.recursion",
  "title": "Call stack while computing fact(3)",
  "viewBox": [0, 0, 360, 260],
  "objects": [
    {"id": "stack", "kind": "array", "x": 24, "y": 236, "cells": [], "cw": 108, "ch": 32, "dir": "up", "slots": 4, "label": "Call stack"},
    {"id": "top", "kind": "pointer", "array": "stack", "index": 0, "label": "top", "side": "right"},
    {"id": "h", "kind": "text", "x": 188, "y": 34, "anchor": "start", "text": "fact(n):", "bold": true},
    {"id": "base", "kind": "text", "x": 188, "y": 60, "anchor": "start", "mono": true, "size": 13, "text": "if n == 0: return 1"},
    {"id": "rec", "kind": "text", "x": 188, "y": 86, "anchor": "start", "mono": true, "size": 13, "text": "return n * fact(n-1)"},
    {"id": "msg", "kind": "text", "x": 188, "y": 160, "anchor": "start", "text": "", "bold": true, "tone": "good"}
  ],
  "steps": [
    {"caption": "Calling fact(3) pushes a frame on the call stack. The frame stays there until the call returns.",
     "push": {"id": "stack", "value": "fact(3)"}, "move": {"id": "top", "index": 0}, "show": ["top"], "highlight": ["rec"]},
    {"caption": "fact(3) needs fact(2) before it can multiply, so it waits. fact(2) goes on top. fact(3) is paused underneath.",
     "push": {"id": "stack", "value": "fact(2)"}, "move": {"id": "top", "index": 1}, "highlight": ["rec"]},
    {"caption": "Same again. fact(1) is pushed. Each call is one frame deeper.",
     "push": {"id": "stack", "value": "fact(1)"}, "move": {"id": "top", "index": 2}, "highlight": ["rec"]},
    {"caption": "n = 0 is the base case. fact(0) is pushed, and it is the first call that can return without calling again.",
     "push": {"id": "stack", "value": "fact(0)"}, "move": {"id": "top", "index": 3}, "highlight": ["base"]},
    {"caption": "fact(0) returns 1 and is popped. Last in, first out: only the top frame can leave.",
     "pop": {"id": "stack"}, "move": {"id": "top", "index": 2}, "set": {"id": "msg", "text": "fact(0) = 1"}, "highlight": ["base"]},
    {"caption": "fact(1) resumes with the returned 1 and finishes: 1 x 1 = 1. Popped.",
     "pop": {"id": "stack"}, "move": {"id": "top", "index": 1}, "set": {"id": "msg", "text": "fact(1) = 1 x 1 = 1"}, "highlight": ["rec"]},
    {"caption": "fact(2) resumes: 2 x 1 = 2. Popped.",
     "pop": {"id": "stack"}, "move": {"id": "top", "index": 0}, "set": {"id": "msg", "text": "fact(2) = 2 x 1 = 2"}, "highlight": ["rec"]},
    {"caption": "fact(3) = 3 x 2 = 6, and the stack is empty. It was 4 frames deep at most, so the space cost is O(n).",
     "pop": {"id": "stack"}, "hide": ["top"], "set": {"id": "msg", "text": "fact(3) = 3 x 2 = 6"}, "highlight": ["rec"]}
  ]
}
