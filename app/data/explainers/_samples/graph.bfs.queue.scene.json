{
  "id": "graph.bfs.queue",
  "title": "BFS on a small graph with a queue",
  "viewBox": [0, 0, 360, 300],
  "objects": [
    {"id": "ab", "kind": "edge", "from": "A", "to": "B"},
    {"id": "ac", "kind": "edge", "from": "A", "to": "C"},
    {"id": "bd", "kind": "edge", "from": "B", "to": "D"},
    {"id": "cd", "kind": "edge", "from": "C", "to": "D"},
    {"id": "ce", "kind": "edge", "from": "C", "to": "E"},
    {"id": "df", "kind": "edge", "from": "D", "to": "F"},
    {"id": "ef", "kind": "edge", "from": "E", "to": "F"},
    {"id": "A", "kind": "node", "x": 40, "y": 90, "label": "A"},
    {"id": "B", "kind": "node", "x": 115, "y": 40, "label": "B"},
    {"id": "C", "kind": "node", "x": 115, "y": 140, "label": "C"},
    {"id": "D", "kind": "node", "x": 215, "y": 40, "label": "D"},
    {"id": "E", "kind": "node", "x": 215, "y": 140, "label": "E"},
    {"id": "F", "kind": "node", "x": 310, "y": 90, "label": "F"},
    {"id": "q", "kind": "array", "x": 48, "y": 204, "cells": [], "cw": 44, "ch": 36, "slots": 6, "label": "Queue (front on the left)"},
    {"id": "order", "kind": "text", "x": 24, "y": 280, "anchor": "start", "size": 15, "bold": true, "text": "visited order:"}
  ],
  "steps": [
    {"caption": "BFS visits nodes in rings by distance from the start. A queue gives that order: first in, first out. Mark A as seen (amber) and enqueue it.",
     "push": {"id": "q", "value": "A"}, "set": {"id": "A", "tone": "mid"}, "highlight": ["A"]},
    {"caption": "Dequeue A and visit it (green). Its neighbours B and C are new, so enqueue both and mark them seen.",
     "pop": {"id": "q", "end": "front"}, "push": [{"id": "q", "value": "B"}, {"id": "q", "value": "C"}],
     "set": [{"id": "A", "tone": "good"}, {"id": "B", "tone": "mid"}, {"id": "C", "tone": "mid"}, {"id": "order", "text": "visited order: A"}],
     "highlight": ["A", "ab", "ac"]},
    {"caption": "Dequeue B. Its neighbour A is already visited, so skip it. D is new: enqueue it.",
     "pop": {"id": "q", "end": "front"}, "push": {"id": "q", "value": "D"},
     "set": [{"id": "B", "tone": "good"}, {"id": "D", "tone": "mid"}, {"id": "order", "text": "visited order: A B"}],
     "highlight": ["B", "bd", {"id": "ab", "tone": "muted"}]},
    {"caption": "Dequeue C. D is already in the queue, so do not add it twice. E is new: enqueue it.",
     "pop": {"id": "q", "end": "front"}, "push": {"id": "q", "value": "E"},
     "set": [{"id": "C", "tone": "good"}, {"id": "E", "tone": "mid"}, {"id": "order", "text": "visited order: A B C"}],
     "highlight": ["C", "ce", {"id": "cd", "tone": "muted"}, {"id": "ac", "tone": "muted"}]},
    {"caption": "Dequeue D. Only F is new. D and E are both 2 edges from A, which is why they leave the queue before F.",
     "pop": {"id": "q", "end": "front"}, "push": {"id": "q", "value": "F"},
     "set": [{"id": "D", "tone": "good"}, {"id": "F", "tone": "mid"}, {"id": "order", "text": "visited order: A B C D"}],
     "highlight": ["D", "df"]},
    {"caption": "Dequeue E. Its only unseen neighbour, F, is already queued. Nothing to add.",
     "pop": {"id": "q", "end": "front"},
     "set": [{"id": "E", "tone": "good"}, {"id": "order", "text": "visited order: A B C D E"}],
     "highlight": ["E", {"id": "ef", "tone": "muted"}]},
    {"caption": "Dequeue F and the queue is empty. Every ring finishes before the next starts, so each node was first reached by a shortest path (fewest edges).",
     "pop": {"id": "q", "end": "front"},
     "set": [{"id": "F", "tone": "good"}, {"id": "order", "text": "visited order: A B C D E F"}],
     "highlight": ["F"]}
  ]
}
