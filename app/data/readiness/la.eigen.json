{
  "chapter_id": "la.eigen",
  "questions": [
    {"id":"mat-vec","stem":"Compute $Ax$ for $A=\\begin{pmatrix}1&2\\\\3&4\\end{pmatrix}$ and $x=\\begin{pmatrix}1\\\\1\\end{pmatrix}$.","type":"MCQ","options":["(4, 6)","(3, 7)","(7, 3)","(1, 4)"],"answer":"B","tests":"found.vectors_matrices","explain":"Dot each row of A with x: row 1 gives 1 + 2 = 3 and row 2 gives 3 + 4 = 7, so Ax = (3, 7)."},
    {"id":"a-minus-lambda","stem":"For $A=\\begin{pmatrix}4&1\\\\2&3\\end{pmatrix}$, which matrix is $A-5I$?","type":"MCQ","options":["$\\begin{pmatrix}-1&-4\\\\-3&-2\\end{pmatrix}$","$\\begin{pmatrix}9&1\\\\2&8\\end{pmatrix}$","$\\begin{pmatrix}4&-4\\\\-3&3\\end{pmatrix}$","$\\begin{pmatrix}-1&1\\\\2&-2\\end{pmatrix}$"],"answer":"D","tests":"found.vectors_matrices","explain":"Subtracting 5I takes 5 off the diagonal entries only: 4 − 5 = −1 and 3 − 5 = −2, and the off-diagonal entries stay 1 and 2."},
    {"id":"expand-char","stem":"Expand (2 − λ)(3 − λ) − 2.","type":"MCQ","options":["λ² − 5λ + 4","λ² − 5λ + 8","λ² + 5λ + 4","λ² − λ + 4"],"answer":"A","tests":"found.algebra","explain":"(2 − λ)(3 − λ) = 6 − 5λ + λ². Subtracting 2 leaves λ² − 5λ + 4."},
    {"id":"solve-roots","stem":"Solve x² − 7x + 12 = 0.","type":"MCQ","options":["x = −3 or x = −4","x = 3 or x = 4","x = 2 or x = 6","x = 1 or x = 12"],"answer":"B","tests":"found.algebra","explain":"Factor as (x − 3)(x − 4) = 0, so x = 3 or x = 4. Check: the roots add to 7 and multiply to 12."},
    {"id":"det-2x2","stem":"What is the determinant of $\\begin{pmatrix}3&1\\\\2&4\\end{pmatrix}$?","type":"NAT","answer":10,"tests":"la.matrices_det","explain":"For a 2 × 2 matrix the determinant is ad − bc = 3·4 − 1·2 = 10."}
  ]
}
