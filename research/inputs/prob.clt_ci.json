{
 "topic_id": "prob.clt_ci",
 "atoms": [
  {
   "id": "s1",
   "name": "Mean of the sample mean",
   "one_line": "$E[\\bar X]=\\mu$, $\\mathrm{Var}(\\bar X)=\\sigma^2/n$."
  },
  {
   "id": "s2",
   "name": "Standard error",
   "one_line": "$SE=\\sigma/\\sqrt n$; shrinks with $\\sqrt n$."
  },
  {
   "id": "s3",
   "name": "Central limit theorem",
   "one_line": "Sums are $\\approx N(n\\mu,n\\sigma^2)$; means $\\approx N(\\mu,\\sigma^2/n)$."
  },
  {
   "id": "s4",
   "name": "Normal approximation to binomial",
   "one_line": "$N(np,np(1-p))$; continuity correction $\\pm0.5$."
  },
  {
   "id": "s5",
   "name": "z interval for a mean",
   "one_line": "$\\bar x\\pm z\\,\\sigma/\\sqrt n$; $z=1.645,1.96,2.576$."
  },
  {
   "id": "s6",
   "name": "Interval width and sample size",
   "one_line": "$n\\ge(z\\sigma/E)^2$, rounded up."
  },
  {
   "id": "s7",
   "name": "Interval for a proportion",
   "one_line": "$\\hat p\\pm z\\sqrt{\\hat p(1-\\hat p)/n}$; worst case $p=0.5$."
  },
  {
   "id": "s8",
   "name": "Chi-square distribution",
   "one_line": "$\\chi^2_k=\\sum Z_i^2$; mean $k$, variance $2k$; $\\frac{(n-1)S^2}{\\sigma^2}\\sim\\chi^2_{n-1}$."
  },
  {
   "id": "s9",
   "name": "t distribution",
   "one_line": "$T=\\frac{\\bar X-\\mu}{S/\\sqrt n}\\sim t_{n-1}$; heavier tails; variance $\\frac k{k-2}$."
  },
  {
   "id": "s10",
   "name": "Unbiased and MLE estimators",
   "one_line": "$S^2$ divides by $n-1$ (unbiased); MLE divides by $n$; $S$ is biased."
  },
  {
   "id": "s11",
   "name": "Reading a confidence level",
   "one_line": "The level is the long-run coverage of the method, not the chance for one interval."
  }
 ],
