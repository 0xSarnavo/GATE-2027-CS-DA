{
 "topic_id": "la.proj",
 "atoms": [
  {
   "id": "p1",
   "name": "Dot product and orthogonality",
   "one_line": "$x\\perp y\\iff x^Ty=0$; $\\|x\\|^2=x^Tx$."
  },
  {
   "id": "p2",
   "name": "Projection onto a vector",
   "one_line": "$\\operatorname{proj}_a b=\\dfrac{a^Tb}{a^Ta}a$, matrix $P=\\dfrac{aa^T}{a^Ta}$."
  },
  {
   "id": "p3",
   "name": "Projection matrix properties",
   "one_line": "$P^2=P$, $P^T=P$, eigenvalues $0,1$, $\\operatorname{tr}P=\\operatorname{rank}P$."
  },
  {
   "id": "p4",
   "name": "Complement and null space",
   "one_line": "$I-P$ projects onto $U^\\perp$; $\\dim\\ker P=n-\\operatorname{rank}P$."
  },
  {
   "id": "p5",
   "name": "Projection onto a subspace",
   "one_line": "$P=A(A^TA)^{-1}A^T$; with orthonormal $Q$: $P=QQ^T$."
  },
  {
   "id": "p6",
   "name": "Orthogonal matrices",
   "one_line": "$Q^TQ=I$, preserves length, $\\det=\\pm1$, $|\\lambda|=1$."
  },
  {
   "id": "p7",
   "name": "Idempotent matrices",
   "one_line": "$A^2=A$: eigenvalues $0,1$, rank $=$ trace, not always symmetric."
  },
  {
   "id": "p8",
   "name": "Partitioned matrices",
   "one_line": "Block multiplication; block triangular: $\\det$ and rank split."
  },
  {
   "id": "p9",
   "name": "Quadratic forms",
   "one_line": "$x^TAx=x^T\\tfrac{A+A^T}{2}x$; extremes are eigenvalues."
  }
 ],
