 "atoms": [
  {
   "id": "s1",
   "name": "Definition via $A^TA$",
   "one_line": "$\\sigma_i=\\sqrt{\\lambda_i(A^TA)}\\ge0$; rank = number of non-zero $\\sigma_i$."
  },
  {
   "id": "s2",
   "name": "Shapes and $AA^T$",
   "one_line": "$A=U\\Sigma V^T$; $AA^T$ and $A^TA$ share their non-zero eigenvalues."
  },
  {
   "id": "s3",
   "name": "Special matrices",
   "one_line": "Diagonal, symmetric, orthogonal, rank-one, projection."
  },
  {
   "id": "s4",
   "name": "Norm identities",
   "one_line": "$\\|A\\|_2=\\sigma_1$, $\\|A\\|_F^2=\\sum\\sigma_i^2$, $|\\det A|=\\prod\\sigma_i$."
  },
  {
   "id": "s5",
   "name": "Best low-rank approximation",
   "one_line": "Rank-$k$ error is $\\sigma_{k+1}$ (2-norm) or $\\sqrt{\\sum_{i>k}\\sigma_i^2}$ (Frobenius)."
  },
  {
   "id": "s6",
   "name": "Singular values versus eigenvalues",
   "one_line": "Equal in size only for normal matrices; $\\sigma_1\\ge|\\lambda|$ always."
  },
  {
   "id": "s7",
   "name": "Condition number",
   "one_line": "$\\kappa=\\sigma_1/\\sigma_n$ and $\\kappa(A^TA)=\\kappa^2$."
  },
  {
   "id": "s8",
   "name": "SVD and PCA",
   "one_line": "Centered $X$ with $n$ rows: variance along PC $i$ is $\\sigma_i^2/(n-1)$."
  }
