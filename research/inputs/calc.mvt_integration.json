{
 "topic_id": "calc.mvt_integration",
 "atoms": [
  {
   "id": "m1",
   "name": "Fundamental theorem",
   "one_line": "$\\int_a^bf=F(b)-F(a)$."
  },
  {
   "id": "m2",
   "name": "Substitution",
   "one_line": "Let $u=g(x)$; change the limits with it."
  },
  {
   "id": "m3",
   "name": "Integration by parts",
   "one_line": "$\\int u\\,dv=uv-\\int v\\,du$; pick $u$ that simplifies."
  },
  {
   "id": "m4",
   "name": "Odd and even symmetry",
   "one_line": "Odd on $[-a,a]$ gives 0; even gives $2\\int_0^a$."
  },
  {
   "id": "m5",
   "name": "Pairing and king property",
   "one_line": "$\\int_0^af(x)=\\int_0^af(a-x)$; $f(x)+f(a-x)=c\\Rightarrow\\int_0^af=\\frac{ca}2$."
  },
  {
   "id": "m6",
   "name": "Rolle's theorem",
   "one_line": "$f(a)=f(b)$ gives $f'(c)=0$ for some $c$."
  },
  {
   "id": "m7",
   "name": "Mean value theorem",
   "one_line": "$f(b)-f(a)=f'(c)(b-a)$; derivative bounds bound the change."
  },
  {
   "id": "m8",
   "name": "Area and absolute value",
   "one_line": "Split at sign changes or crossings; integrate top minus bottom."
  },
  {
   "id": "m9",
   "name": "Improper integrals",
   "one_line": "$\\int_1^\\infty x^{-p}$ converges iff $p>1$; $\\int_0^1x^{-p}$ iff $p<1$."
  },
  {
   "id": "m10",
   "name": "Sum versus integral",
   "one_line": "Monotone $f$: unit strips are bounded by left and right sums."
  },
  {
   "id": "m11",
   "name": "Average value",
   "one_line": "$\\frac1{b-a}\\int_a^bf$."
  },
  {
   "id": "m12",
   "name": "Differentiating an integral",
   "one_line": "$\\frac d{dx}\\int_a^{h(x)}f=f(h)h'$."
  }
 ],
