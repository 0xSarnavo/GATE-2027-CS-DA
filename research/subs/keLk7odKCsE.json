[[0, "\u0921\u093f\u092f\u0930 \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f\u094d\u0938 \u0935\u0947\u0932\u0915\u092e \u091f\u0942 \u0917\u0947\u091f\u094d\u0938 \u092e\u0936\u0930\u094d\u0938 \u0906\u091c"], [2, "\u0915\u0940 \u0907\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u0947\u0928 \u0915\u0930\u0928\u0947 \u091c\u093e \u0930\u0939\u093e"], [3, "\u0939\u0942\u0902 \u092e\u0940\u0928 \u092e\u0940\u0921\u093f\u092f\u0928 \u090f\u0902\u0921 \u092e\u094b\u0921 \u0914\u0930 \u092f\u0947 \u0924\u0940\u0928\u094b\u0902 \u091f\u0949\u092a\u093f\u0915"], [6, "\u091c\u094b \u0939\u0948 \u0935\u094b \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0915\u0939 \u0932\u094b \u092f\u093e \u092b\u093f\u0930"], [8, "\u0938\u094d\u091f\u0947\u091f\u093f\u0938\u094d\u091f\u093f\u0915\u094d\u0938 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0939\u0940 \u0907\u0902\u092a\u094b\u0930\u094d\u091f\u0947\u0902\u091f \u0914\u0930"], [11, "\u092c\u0947\u0938\u093f\u0915 \u092c\u094d\u0932\u0949\u0915 \u0939\u0948 \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f\u094d\u0938 \u0915\u0940 \u0905\u0915\u094d\u0938\u0930 \u0939\u092e\u0947\u0936\u093e"], [13, "\u091c\u094b \u0939\u0948 \u0915\u094b\u0936\u093f\u0936 \u0930\u0939\u0924\u0940 \u0939\u0948 \u0915\u093f \u0939\u093e\u0908 \u0932\u0947\u0935\u0932 \u091f\u0949\u092a\u093f\u0915\u094d\u0938"], [15, "\u0915\u094b \u0915\u0902\u092a\u094d\u0932\u0940\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u092c\u091f \u0928\u0939\u0940\u0902 \u0917\u093e\u0907\u0938 \u0939\u092e\u0947\u0936\u093e"], [18, "\u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u092e\u0947\u0902 \u092e\u0948\u0925\u092e\u0947\u091f\u093f\u0915\u094d\u0938 \u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e"], [20, "\u092c\u0947\u0938\u093f\u0915 \u0938\u0947 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u094b \u0924\u093e\u0915\u093f \u0939\u0930 \u090f\u0915 \u091c\u0917\u0939 \u092a\u0947"], [23, "\u0905\u0917\u0930 \u0906\u092a \u0915\u0939\u0940\u0902 \u092a\u0947 \u092d\u0940 \u092c\u093e\u0924 \u0915\u0930\u094b \u0939\u0930 \u090f\u0915"], [25, "\u0915\u094d\u0932\u0938\u094d\u091f\u0930\u093f\u0902\u0917 \u090f\u0932\u094d\u0917\u094b\u0930\u093f\u0925\u092e \u0915\u0940 \u092c\u093e\u0924 \u0915\u0930 \u0932\u094b"], [26, "\u0915\u094d\u0932\u093e\u0938\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u090f\u0932\u094d\u0917\u094b\u0930\u093f\u0925\u092e\u094d\u0938 \u0915\u0940 \u092c\u093e\u0924 \u0915\u0930 \u0932\u094b"], [28, "\u0915\u0939\u0940\u0902 \u0928\u093e \u0915\u0939\u0940\u0902 \u0906\u092a\u0915\u094b \u092e\u0940\u0928 \u092e\u0940\u0921\u093f\u092f\u0928 \u092e\u094b\u0921 \u092f\u0947"], [31, "\u091a\u0940\u091c\u0947\u0902 \u0906\u0939\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u092c\u0947\u0938\u093f\u0915"], [33, "\u092a\u0924\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0915\u093f \u092e\u0940\u0928 \u092e\u0940\u0921\u093f\u092f\u0928 \u092e\u094b\u0921 \u092d\u0940"], [36, "\u0921\u093f\u0938\u0940\u091c\u0928 \u092e\u0947\u0915\u093f\u0902\u0917 \u092e\u0947\u0902 \u0939\u0947\u0932\u094d\u092a \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0902 \u0939\u0948"], [38, "\u092f\u0947 \u092c\u0921\u093c\u093e \u0938\u093f\u0902\u092a\u0932 \u0938\u093e \u091f\u0949\u092a\u093f\u0915 \u0932\u0947\u0915\u093f\u0928 \u0921\u0947\u0932\u0940 \u0932\u093e\u0907\u092b"], [40, "\u092e\u0947\u0902 \u0906\u092a \u0907\u0938\u0915\u094b \u092f\u0942\u091c \u0915\u0930\u0924\u0947 \u0939\u094b \u0914\u0930 \u092f\u0939 \u0921\u093f\u0938\u0940\u091c\u0928"], [43, "\u092e\u0947\u0915\u093f\u0902\u0917 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u091c\u094d\u092f\u093e\u0926\u093e \u0939\u0947\u0932\u094d\u092a \u0915\u0930\u0924\u0940 \u0939\u0948 \u092e\u0948\u0902"], [44, "\u0906\u092a\u0915\u094b \u090f\u0917\u094d\u091c\u093e\u0902\u092a\u0932 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0924\u093e\u090a\u0902\u0917\u093e \u092e\u0940\u0928 \u0915\u094d\u092f\u093e"], [47, "\u0939\u094b\u0924\u093e \u0939\u0948 \u092e\u0940\u0921\u093f\u092f\u0928 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u092e\u094b\u0921 \u0915\u094d\u092f\u093e"], [48, "\u0939\u094b\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u093e\u0925 \u0939\u0940 \u0938\u093e\u0925 \u0915\u0948\u0938\u0947 \u092f\u0947 \u0939\u0947\u0932\u094d\u092a \u0915\u0930\u0924\u0940"], [51, "\u0939\u0948 \u0921\u093f\u0938\u0940\u091c\u0928 \u0932\u0947\u0928\u0947 \u092e\u0947\u0902 \u0938\u093f\u0902\u092a\u0932 \u0938 \u090f\u0917\u094d\u091c\u093e\u0902\u092a\u0932 \u0938\u0947"], [54, "\u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0940\u0928 \u092e\u0940\u0928 \u0915\u093e"], [57, "\u092e\u0924\u0932\u092c \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u092e\u0940\u0928 \u091c\u093f\u0938\u0915\u094b \u0939\u092e \u092c\u094b\u0932 \u0938\u0915\u0924\u0947"], [58, "\u0939\u0948\u0902 \u092e\u0940\u0928 \u092f\u093e \u092b\u093f\u0930 \u090f\u0935 \u090f\u0935\u0930\u0947\u091c \u0914\u0930 \u092f\u0939 \u0938\u093f\u0902\u092a\u0932 \u0938\u093e"], [61, "\u092b\u093e\u0930\u094d\u092e\u0942\u0932\u093e \u0939\u0948 \u0907\u0938\u0915\u093e \u0915\u093f \u091c\u093f\u0924\u0928\u0940 \u092d\u0940 \u0935\u0948\u0932\u094d\u092f\u0942\u091c"], [64, "\u0906\u092a\u0915\u094b \u0926\u0947 \u0930\u0916\u0940 \u0939\u0948 \u0938\u092c\u0915\u094b \u091f\u094b\u091f\u0932 \u0915\u0930 \u0926\u094b \u0938\u092c\u0915\u093e"], [67, "\u090f\u0921\u093f\u0936\u0928 \u0915\u0930 \u0926\u094b \u0921\u093f\u0935\u093e\u0907\u0921 \u092c\u093e\u092f \u091f\u094b\u091f\u0932 \u0928\u0902\u092c\u0930 \u0911\u092b"], [70, "\u0935\u0948\u0932\u094d\u092f\u0942\u091c \u0915\u0930 \u0926\u094b 