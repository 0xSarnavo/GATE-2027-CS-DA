8 \u0932\u0947\u0928\u093e \u0939\u0948 \u0924\u094b \u091c\u0928\u0930\u0932\u0940 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948"], [104, "\u0906\u092a\u0915\u0947 \u092a\u0947\u0930\u0947\u0902\u091f\u094d\u0938 \u092d\u0940 \u0906\u092a \u0932\u094b\u0917 \u092d\u0940 \u0915\u0939\u0940\u0902 \u0928\u093e \u0915\u0939\u0940\u0902"], [106, "\u092f\u0947 \u0926\u0947\u0916\u0924\u0947 \u0939\u094b \u0915\u093f \u092f\u093e\u0930 \u0909\u0938 \u0915\u0949\u0932\u0947\u091c \u0915\u093e"], [108, "\u092f\u0942\u0928\u093f\u0935\u0930\u094d\u0938\u093f\u091f\u0940 \u0915\u093e \u092a\u0948\u0915\u0947\u091c \u0915\u093f\u0924\u0928\u093e \u0939\u0948 \u0914\u0930 \u0935\u0939\u093e\u0902 \u092a\u0947"], [111, "\u0915\u094d\u092f\u093e \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u0928\u0932\u0940 \u0939\u093e\u0908\u090f\u0938\u094d\u091f \u092a\u0948\u0915\u0947\u091c"], [113, "\u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u093e\u0928\u092c\u0942\u091d \u0915\u0947 \u0924\u093e\u0915\u093f \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f"], [116, "\u091c\u094b \u0939\u0948 \u0935\u094b \u0915\u0939\u0940\u0902 \u0928\u093e \u0915\u0939\u0940\u0902 \u091c\u094b \u0939\u0948 \u0935\u094b \u0906\u090f \u0939\u092e\u093e\u0930\u0947"], [118, "\u092a\u093e\u0938 \u0914\u0930 \u0915\u0939\u0940\u0902 \u0928\u093e \u0915\u0939\u0940\u0902 \u092e\u0924\u0932\u092c \u090f\u0915 \u0924\u0930\u0939 \u0938\u0947 \u0938\u0947"], [120, "\u0930\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u093e\u0930 \u0905\u091a\u094d\u091b\u093e 30 \u0932\u093e\u0916 \u0915\u093e \u092a\u0948\u0915\u0947\u091c \u0932\u0917\u093e"], [122, "\u0939\u0948 \u092f\u0939\u093e\u0902 \u092a\u0947 32 \u0932\u093e\u0916 \u0915\u093e \u092a\u0948\u0915\u0947\u091c \u0932\u0917\u093e \u0939\u0948 \u0932\u0947\u0915\u093f\u0928"], [125, "\u0906\u092a\u0915\u094b \u0915\u092d\u0940 \u092d\u0940 \u0939\u093e\u0908\u090f\u0938\u094d\u091f \u092a\u0948\u0915\u0947\u091c \u0915\u094b \u0926\u0947\u0916 \u0915\u0947 \u091c\u094b"], [127, "\u0939\u0948 \u0935\u094b \u0921\u093f\u0938\u0940\u091c\u0928 \u0928\u0939\u0940\u0902 \u0932\u0947\u0928\u093e \u0928\u093e \u0939\u0940 \u0932\u094b\u090f\u0938\u094d\u091f"], [130, "\u092a\u0948\u0915\u0947\u091c \u0915\u094b \u0932\u0947\u0915\u0947 \u0921\u093f\u0938\u0940\u091c\u0928 \u091c\u094b \u0939\u0948 \u0935\u094b \u0932\u0947\u0928\u093e \u0939\u094b\u0924\u093e"], [133, "\u0939\u0948 \u0924\u094b \u0935\u0939\u093e\u0902 \u092a\u0947 \u091c\u0928\u0930\u0932\u0940 \u0915\u094d\u092f\u093e \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948"], [135, "\u090f\u0935\u0930\u0947\u091c \u092a\u0948\u0915\u0947\u091c \u0906\u092a \u0926\u0947\u0916\u094b \u090f\u0935\u0930\u0947\u091c \u092a\u0948\u0915\u0947\u091c \u0915\u093e \u092e\u0924\u0932\u092c"], [138, "\u0915\u094d\u092f\u093e \u0939\u0948 \u0915\u093f \u091f\u094b\u091f\u0932 \u0915\u093f\u0924\u0928\u0947 \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f \u091c\u094b \u0939\u0948\u0902 \u0935\u094b"], [140, "\u092a\u094d\u0932\u0947\u0938 \u0939\u0941\u090f \u0939\u0948\u0902 \u0909\u0928\u0915\u0947 \u092a\u0948\u0915\u0947\u091c\u0947\u0938 \u0915\u094d\u092f\u093e \u0939\u0948"], [142, "\u0921\u093f\u0935\u093e\u0907\u0921 \u092c\u093e\u092f \u091f\u094b\u091f\u0932 \u0928\u0902\u092c\u0930 \u0911\u092b \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f\u094d\u0938 \u0932\u0947\u0915\u093f\u0928"], [145, "\u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u0914\u0930 \u091a\u0940\u091c \u092f\u0939\u093e\u0902 \u092a\u0947 \u092c\u0924\u093e \u0926\u0942\u0902 \u0935\u0948\u0938\u0947"], [146, "\u0924\u094b \u092f\u0947 \u0907\u0938 \u091f\u0949\u092a\u093f\u0915 \u0938\u0947 \u0930\u093f\u0932\u0947\u091f\u0947\u0921 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0915\u0939\u093e\u0928\u0940"], [148, "\u0906\u092a\u0915\u094b \u0938\u092e\u091d \u092e\u0947\u0902 \u0906\u0939\u0940 \u0917\u0908 \u0932\u0947\u0915\u093f\u0928 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0940 \u091c\u0917\u0939"], [151, "\u092a\u0947 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u092f\u0942\u0928\u093f\u0935\u0930\u094d\u0938\u093f\u091f\u0940 \u0915\u0949\u0932\u0947\u091c\u0947\u0938 \u092e\u0947\u0902"], [154, "\u0928\u0902\u092c\u0930 \u0911\u092b \u090f\u0932\u093f\u091c\u093f\u092c\u0932 \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f\u094d\u0938 \u091c\u094b \u0939\u0948\u0902 \u0935\u094b"], [156, "\u092c\u0939\u0941\u0924 \u0915\u092e \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0935\u0948\u0938\u0947 \u091f\u094b\u091f\u0932 \u0928\u0902\u092c\u0930 \u0911\u092b"], [158, "\u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f\u094d\u0938 \u0939\u094b\u0902\u0917\u0947 \u0932\u0947\u091f\u094d\u0938 \u0938\u0947 1000 \u0909\u0928\u092e\u0947\u0902 \u0938\u0947"], [161, "500 \u090f\u0932\u093f\u091c\u093f\u092c\u0932 \u0939\u094b\u0902\u0917\u0947 \u092c\u093e\u0915\u0940 500 \u092c\u0947\u091a\u093e\u0930\u0947"], [163, "\u090f\u0932\u093f\u091c\u093f\u092c\u0932 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0947 \u0915\u0908\u092f\u094b\u0902 \u0915\u0940 \u0930\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948"], [165, "\u0915\u0907\u092f\u094b\u0902 \u0915\u093e \u0915\u094d\u092f\u093e \u0915\u0941\u091b \u0928\u093e \u0915\u0941\u091b \u092a\u0902\u0917\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u0924\u094b"], [167, "\u0909\u0928 500 \u092e\u0947\u0902 \u0938\u0947 \u0905\u0917\u0930 100 \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u092f\u093e 50"], [169, "\u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0939\u094b \u092d\u0940 \u0917\u0908 \u0924\u094b \u092c\u0939\u0941\u0924 \u092c\u0921\u093c\u0940"], [172, "\u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948 1000 \u092e\u0947\u0902 \u0938\u0947 \u0926\u0947\u0916\u094b \u0906\u092a \u0915\u093f\u0924\u0928\u0947 \u0939\u0948"], [174, "1000 \u092e\u0947\u0902 \u0938\u0947 \u0924\u094b \u092f\u0947 10 \u092a\u0930 \u092d\u0940 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e"], [177, "\u0932\u0947\u0915\u093f\u0928 \u0915\u0908 \u092c\u093e\u0930 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0947 \u091a\u0940\u091c\u0947\u0902"], [178, "\u0939\u093e\u0907\u0921 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0924\u094b \u0939\u092e\u0947\u0936\u093e \u090f\u0921\u092e\u093f\u0936\u0928 \u0932\u0947\u0928\u0947 \u0938\u0947"], [180, "\u092a\u0939\u0932\u0947 \u092f\u0947 \u091a\u0940\u091c \u091c\u0930\u0942\u0930 \u0926\u0947\u0916\u093e \u0915\u0930\u094b \u0915\u093f\u0924\u0928\u0947 \u090f\u0932\u093f\u091c\u093f\u092c\u0932"], [183, "\u0939\u0948 \u0915\u093f\u0924\u0928\u0947 \u091f\u094b\u091f\u0932 \u0939\u0948 \u0920\u0940\u0915 \u0939\u0948 \u091a\u0932\u094b \u092f\u0947 \u0915\u0939\u093e\u0928\u0940 \u0938\u092e\u091d"], [186, "\u092e\u0947\u0902 \u0906 \u0917\u0908 \u0924\u094b \u0906\u092a\u0915\u094b \u0939\u0947\u0932\u094d\u092a \u0915\u0930\u0924\u093e \u0939\u0948 \u0915\u0939\u0940\u0902 \u0928\u093e"], [188, "\u0915\u0939\u0940\u0902 \u090f\u0915 \u0921\u093f\u0938\u0940\u091c\u0928 \u0932\u0947\u0928\u0947 \u092e\u0947\u0902 \u0915\u093f \u092f\u093e\u0930 \u092e\u0947\u0930\u0947 \u0915\u094b"], [189, "\u0907\u0938 \u091c\u0917\u0939 \u092a\u0947 \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u092f\u093e \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f"], [191, "\u0924\u094b \u092f\u0947 \u0906\u092a\u0915\u093e \u091c\u094b \u0939\u0948 \u0935\u094b \u090f\u0915 \u0915\u094d\u0930\u093e\u0907\u091f\u0947\u0930\u093f\u092f\u093e \u0939\u094b"], [194, "\u0917\u092f\u093e \u0905\u092c \u092f\u0939\u093e\u0902 \u092a\u0947 \u0905\u0917\u0930 \u0939\u092e \u092c\u093e\u0924 \u0915\u0930\u0947\u0902 \u0915\u0908 \u092c\u093e\u0930"], [196, "\u0906\u092a\u0915\u094b \u090f\u0917\u094d\u091c\u093e\u092e \u092e\u0947\u0902 \u092a\u0942\u091b \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f"], [197, "\u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u092e\u0947\u0902 \u0939\u092e \u0932\u094b\u0917 \u092c\u093e\u0924 \u0915\u0930\u0947\u0902 \u0939\u0948\u0902 \u0924\u094b"], [199, "\u0906\u0909\u091f \u0932\u093e\u092f\u0930\u094d\u0938 \u0915\u0940 \u092c\u093e\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0906\u0909\u091f \u0932\u093e\u092f\u0930\u094d\u0938"], [201, "\u092e\u0924\u0932\u092c \u0915\u093f \u0906\u092a\u0915\u093e \u0921\u093e\u091f\u093e \u0939\u0948 \u0909\u0938 \u0921\u093e\u091f\u093e \u092e\u0947\u0902 \u0915\u094b\u0908 \u0910\u0938\u0940"], [204, "\u0935\u0948\u0932\u094d\u092f\u0942 \u091c\u094b \u0905\u0932\u0917 \u0938\u0947 \u0939\u0940 \u0939\u0948 \u091c\u0948\u0938\u0947 \u0928\u0949\u0930\u094d\u092e\u0932\u0940 2 3"], [208, "4 5 \u0920\u0940\u0915 \u0939\u0948 \u092f\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u0939\u0948\u0902 \u0932\u0947\u0915\u093f\u0928"], [211, "32 \u0905\u0932\u0917 \u0939\u0940 \u0939\u094b \u0917\u092f\u093e \u092e\u0924\u0932\u092c \u092c\u0921\u093c\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u0939\u094b \u0917\u0908"], [214, "\u092f\u093e \u092c\u0939\u0941\u0924 \u0939\u0940 \u091b\u094b\u091f\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u0905\u0917\u0930 \u0939\u092e \u092e\u0940\u0928"], [216, "\u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0907\u0938 \u091f\u093e\u0907\u092a \u0915\u093e \u0921\u093e\u091f\u093e"], [219, "\u091c\u093f\u0938\u0915\u094b \u0906\u0909\u091f \u0932\u093e\u092f\u0930\u094d\u0938 \u092c\u094b\u0932\u0924\u0947 \u0939\u0948\u0902 \u092f\u0947 \u0906\u092a\u0915\u093e \u092c\u0921\u093c\u093e"], [221, "\u0907\u092b\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0948 \u092e\u0940\u0928 \u0915\u0947 \u090a\u092a\u0930 \u0905\u0917\u0930 \u092e\u0948\u0902 \u0907\u0938\u0915\u094b"], [224, "\u0915\u092e \u0915\u0930 \u0926\u0942\u0902 \u0924\u094b \u0935\u0948\u0932\u094d\u092f\u0942 \u0906\u092a\u0915\u0940 \u092c\u0939\u0941\u0924 \u091c\u094d\u092f\u093e\u0926\u093e"], [226, "\u0907\u092b\u0947\u0915\u094d\u091f \u0939\u094b\u0917\u0940 \u0905\u0917\u0930 \u0906\u092a \u0907\u0938\u0915\u093e \u092e\u0940\u0928 \u0928\u093f\u0915\u093e\u0932\u094b \u0917 \u0924\u094b"], [228, "\u0935\u0948\u0932\u094d\u092f\u0942 \u0915\u094d\u092f\u093e \u0906\u090f\u0917\u0940 \u0906\u092a\u0915\u0940 \u0928\u093e\u0907\u0928 \u0906\u090f\u0917\u0940 \u092e\u0928\u0940"], [231, "\u090f\u0935\u0930\u0947\u091c \u092a\u0948\u0915\u0947\u091c \u0932\u0917\u0947\u0917\u093e \u0906\u092a\u0915\u094b 9 \u0932\u093e\u0916 \u092f\u0947 \u0924\u094b \u092c\u0939\u0941\u0924"], [233, "\u0905\u091a\u094d\u091b\u093e \u092a\u0948\u0915\u0947\u091c \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0905\u0917\u0930 \u0906\u092a \u0927\u094d\u092f\u093e\u0928 \u0938\u0947"], [235, "\u0926\u0947\u0916\u094b \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f \u0915\u093e \u092a\u0948\u0915\u0947\u091c 2 3 4 5"], [239, "\u0924\u0915 \u0939\u0940 \u0939\u0948 \u0938\u093f\u0930\u094d\u092b \u0907\u0938 32 \u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u092a\u0948\u0915\u0947\u091c \u091c\u094b"], [243, "\u0939\u0948 \u0935\u094b \u090f\u0935\u0930\u0947\u091c \u0928\u093e\u0907\u0928 \u0939\u094b \u0917\u092f\u093e \u0924\u094b \u092f\u0939 \u0915\u0939\u0940\u0902 \u0928\u093e"], [246, "\u0915\u0939\u0940\u0902 \u0906\u0909\u091f\u0932\u093e\u092f\u0930 \u091c\u094b \u0939\u0948 \u0935\u094b \u092e\u0940\u0928 \u0935\u0948\u0932\u094d\u092f\u0942 \u0915\u0947 \u090a\u092a\u0930"], [248, "\u092c\u0939\u0941\u0924 \u091c\u094d\u092f\u093e\u0926\u093e \u0907\u092b\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u092f\u0947"], [250, "\u091b\u094b\u091f\u0947-\u091b\u094b\u091f\u0947 \u092a\u0949\u0907\u0902\u091f\u094d\u0938 \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0907\u0902\u092a\u0949\u0930\u094d\u091f\u0947\u0902\u091f \u0939\u0948"], [253, "\u0926\u0942\u0938\u0930\u093e \u0906 \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u0940 \u092f\u0939\u093e\u0902 \u092a\u0947 \u0906\u092a\u0915\u093e \u092e\u0940\u0921\u093f\u092f\u0928"], [256, "\u092e\u0940\u0921\u093f\u092f\u0928 \u092d\u0940 \u0906\u092a\u0928\u0947 \u0915\u093f\u092f\u093e \u0939\u094b\u0917\u093e \u0915\u093f \u092e\u093f\u0921 \u0935\u0948\u0932\u094d\u092f\u0942"], [258, "\u0939\u092e\u0928\u0947 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0930\u0928\u0940 \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u0947\u0936\u093e \u092e\u0940\u0921\u093f\u092f\u0928"], [260, "\u091c\u092c \u092d\u0940 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u092a\u0939\u0932\u0947 \u0921\u093e\u091f\u093e \u0915\u094b"], [262, "\u0938\u0949\u0930\u094d\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u092e\u0924\u0932\u092c \u0905\u0917\u0930 \u0930\u0948\u0902\u0921\u092e \u0921\u093e\u091f\u093e"], [264, "\u092a\u0921\u093c\u093e \u0939\u0948 \u0924\u094b \u0909\u0938\u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u0949\u0930\u094d\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e"], [266, "\u0905\u0938\u0947\u0902\u0921\u093f\u0902\u0917 \u092f\u093e \u092b\u093f\u0930 \u0921\u093f\u0938\u0947\u0902\u0921\u093f\u0902\u0917 \u0911\u0930\u094d\u0921\u0930 \u092e\u0947\u0902 \u0909\u0938\u0915\u0947"], [268, "\u092c\u093e\u0926 \u0939\u092e \u0932\u094b\u0917 \u092e\u0940\u0921\u093f\u092f\u0928 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902"], [270, "\u092e\u0940\u0921\u093f\u092f\u0928 \u092e\u0924\u0932\u092c \u092e\u093f\u0921 \u0935\u0948\u0932\u094d\u092f\u0942 \u0906\u092a \u0907\u0938\u0915\u094b \u092c\u094b\u0932 \u0938\u0915\u0924\u0947"], [273, "\u0939\u094b \u0914\u0930 \u092e\u093f\u0921 \u0935\u0948\u0932\u094d\u092f\u0942 \u091c\u094b \u0939\u0948 \u0935\u094b \u092c\u0939\u0941\u0924 \u091c\u0917\u0939 \u092a\u0947"], [275, "\u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u093e\u0930 \u092e\u0924\u0932\u092c \u091c\u0948\u0938\u0947 \u0906\u092a \u0915\u0939 \u0939\u094b \u0915\u093f"], [278, "\u092f\u093e\u0930 \u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f\u094d\u0938 \u0915\u093e \u0921\u093e\u091f\u093e"], [280, "\u0939\u0948 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u094d\u091f\u0942\u0921\u0947\u0902\u091f\u094d\u0938 \u0915\u0947 \u092e\u093e\u0930\u094d\u0915\u094d\u0938 \u0939\u0948 \u0924\u094b"], [281, "\u0906\u092a \u092e\u093f\u0921 \u0935\u0948\u0932\u094d\u092f\u0942 \u0905\u0917\u0930 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b"], [284, "\u0924\u094b \u0906\u092a \u0915\u0939\u0940\u0902 \u0928\u093e \u0915\u0939\u0940\u0902 \u0907\u0938 \u0924\u0930\u0940\u0915\u0947 \u090f\u0935\u0930\u0947\u091c \u090f\u0915 \u0905\u0932\u0917"], [286, "\u091a\u0940\u091c \u0939\u094b\u0917\u0940 \u092e\u093f\u0921 \u0935\u0948\u0932\u094d\u092f\u0942 \u092e\u0924\u0932\u092c \u092c\u0940\u091a \u0915\u0940 \u0935\u0948\u0932\u094d\u092f\u0942"], [288, "\u091c\u0948\u0938\u0947 \u092f\u0939\u093e\u0902 \u092a\u0947 \u0935\u0948\u0932\u094d\u092f\u0942\u091c \u0915\u093f\u0924\u0928\u0940 \u0939\u0948 1 2 3 4 5"], [290, "6 7 \u0924\u094b \u092f\u093e\u0928\u0940 \u0906\u092a \u0938\u093e\u0924 \u0935\u0948\u0932\u094d\u092f\u0942\u091c \u0939\u0948 \u092f\u0939\u093e\u0902 \u092a\u0947 \u091c\u092c"], [293, "\u092d\u0940 \u0939\u092e\u093e\u0930\u093e \u092e\u0940\u0921\u093f\u092f\u0928 \u091c\u094b \u0939\u0948 \u0935\u094b \u0909\u0938\u0915\u0947 \u0905\u0902\u0926\u0930 \u0905\u0917\u0930"], [296, "\u0911\u0921 \u0928\u0902\u092c\u0930 \u0911\u092b \u0935\u0948\u0932\u094d\u092f\u0942\u091c \u0939\u0948 \u0924\u094b \u0906\u092a \u0915\u093f\u0924\u0928\u0940"], [298, "\u0935\u0948\u0932\u094d\u092f\u0942\u091c \u0939\u0948 \u092f\u0939\u093e\u0902 \u092a\u0947 \u091f\u094b\u091f\u0932 \u0938\u0947\u0935\u0928 \u092a\u094d\u0932\u0938 \u092a\u094d\u0935"], [300, "\u0915\u0930\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0921 \u092c\u093e\u092f \u091f\u0942 \u092e\u0924\u0932\u092c 8 \u0921\u093f\u0935\u093e\u0907\u0921 \u092c\u093e\u091f\u0942"], [303, "\u0915\u0930\u094b\u0917\u0947 \u0924\u094b \u0915\u094d\u092f\u093e \u0906\u090f\u0917\u093e \u092b\u094b\u0930 \u092f\u093e\u0928\u0940 \u092b\u094b\u0930\u094d\u0925 \u0935\u0948\u0932\u094d\u092f\u0942"], [305, "1 \u0926\u094b\u0924\u0940 \u091a \u092f\u0947 \u0906\u092a\u0915\u0940 \u0915\u094d\u092f\u093e \u0939\u094b \u0917\u0908 \u092e\u0940\u0921\u093f\u092f\u0928 \u0939\u094b"], [309, "\u0917\u092f\u093e \u0924\u094b \u092f\u0947 \u0906\u092a \u0907\u0938 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0930\u0924\u0947"], [311, "\u0939\u094b \u0932\u0947\u091f\u094d\u0938 \u0938\u092a\u094b\u091c \u0905\u0917\u0930 \u0906\u092a \u0915\u0939\u094b \u0915\u093f \u0938\u0930 \u092f\u0947 \u0924\u094b \u0911\u0921"], [313, "\u0939\u0948 \u0905\u0917\u0930 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0907\u0935\u0928 \u0928\u0902\u092c\u0930 \u0911\u092b \u0935\u0948\u0932\u094d\u092f\u0942\u091c \u0939\u094b\u0924\u0940"], [316, "\u0924\u092c \u0939\u092e \u0915\u094d\u092f\u093e \u0915\u0930\u0924\u0947 \u0932\u0947\u091f\u094d\u0938 \u0938\u0947 \u090f\u0915 \u0914\u0930 \u0935\u0948\u0932\u094d\u092f\u0942 \u0932\u0947"], [318, "\u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u092f\u0939\u093e\u0902 \u092a\u0947 34 \u0932\u0947 \u0932\u094b \u090f\u0915 \u0914\u0930 \u0935\u0948\u0932\u094d\u092f\u0942"], [320, "\u0939\u094b\u0917\u0940 \u0924\u094b \u092f\u0939\u093e\u0902 \u092a\u0947 \u091f\u094b\u091f\u0932 \u0915\u093f\u0924\u0928\u0940 \u0939\u094b\u0917\u0940 \u0906\u0920"], [322, "\u0935\u0948\u0932\u094d\u092f\u0942\u091c \u0939\u094b\u0917\u0940 \u0924\u094b \u0909\u0938 \u0915\u0947\u0938 \u092e\u0947\u0902 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u094b\u0917\u0947"], [324, "\u091c\u094b \u0906\u092a\u0915\u0940 \u092e\u0940\u0921 \u092f\u0939\u093e\u0902 \u092a\u0947 \u091c\u0948\u0938\u0947 \u0926\u0947\u0916\u094b 1 2 3 4"], [328, "\u092f\u093e\u0928\u0940 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u091c\u094b \u092b\u094b\u0930\u094d\u0925 \u0935\u0948\u0932\u094d\u092f\u0942 \u0939\u0948 \u0914\u0930 \u091c\u094b"], [330, "\u092b\u093f\u092b\u094d\u0925 \u0935\u0948\u0932\u094d\u092f\u0942 \u0939\u0948 \u0909\u0938\u0915\u093e \u0921\u093f\u0935\u093e\u0907\u0921 \u092c\u093e\u092f \u091f\u0942 \u0915\u0930 \u0926\u094b"], [333, "\u092e\u0924\u0932\u092c \u092f\u0939\u093e\u0902 \u092a\u0947 \u092b\u094b\u0930\u094d\u0925 \u0935\u0948\u0932\u094d\u092f\u0942 \u0915\u094d\u092f\u093e \u0939\u0948 \u092b\u093e\u0907\u0935"], [335, "\u0914\u0930 \u092b\u093f\u092b\u094d\u0925 \u0935\u0948\u0932\u094d\u092f\u0942 \u0915\u094d\u092f\u093e \u0939\u0948 \u090f\u091f \u0924\u094b \u0906\u092a \u0909\u0938\u0915\u093e"], [338, "\u0915\u094d\u092f\u093e \u0915\u0930 \u0926\u094b \u0921\u093f\u0935\u093e\u0907\u0921 \u092c\u093e\u092f \u091f\u0942 \u0915\u0930 \u0926\u094b \u0924\u094b \u0907\u0935\u0928 \u0915\u0947"], [341, "\u0915\u0947\u0938 \u092e\u0947\u0902 \u0906\u092a \u092e\u0940\u0921\u093f\u092f\u0928 \u0907\u0938 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f"], [342, "\u0915\u0930\u0924\u0947 \u0939\u094b \u0924\u094b \u0911\u0921 \u0914\u0930 \u0907\u0935\u0928 \u0915\u093e \u092b\u0902\u0921\u093e \u092a\u0924\u093e \u0932\u0917 \u0917\u092f\u093e"], [345, "\u0914\u0930 \u0938\u094d\u092a\u0947\u0936\u0932\u0940 \u092e\u0940\u0921\u093f\u092f\u0928 \u092c\u0939\u0941\u0924 \u091c\u0917\u0939 \u092a\u0947 \u092f\u0942\u091c\u093c \u0939\u094b\u0924\u093e"], [347, "\u0939\u0948 \u091c\u0948\u0938\u0947 \u0939\u092e \u092c\u093e\u0907\u0928\u0930\u0940 \u0938\u0930\u094d\u091a \u092f\u0942\u091c\u093c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902"], [349, "\u0921\u093f\u0935\u093e\u0907\u0921 \u090f\u0902\u0921 \u0915\u0902\u0915\u0930 \u091f\u0947\u0915\u094d\u0928\u093f\u0915 \u092f\u0942\u091c\u093c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b"], [351, "\u0921\u093f\u0935\u093e\u0907\u0921 \u090f\u0902\u0921 \u0915\u0902\u0915\u0930 \u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u092e\u093f\u0921 \u0935\u0948\u0932\u094d\u092f\u0942"], [353, "\u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0924\u093e\u0915\u093f \u0926\u094b \u092a\u093e\u0930\u094d\u091f\u094d\u0938 \u092e\u0947\u0902"], [355, "\u0909\u0938\u0915\u094b \u0907\u0915\u094d\u0935\u0932\u0940 \u0921\u093f\u0935\u093e\u0907\u0921 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0947 \u0924\u094b \u092f\u0947 \u092d\u0940"], [358, "\u0906\u092a\u0915\u093e \u090f\u0915 \u0930\u093f\u092f\u0932 \u0932\u093e\u0907\u092b \u090f\u0917\u094d\u091c\u093e\u092e \u090f\u092a\u0932 \u0939\u0948 \u092e\u0940\u0921\u093f\u092f\u0928"], [360, "\u0915\u093e \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0906 \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u0940 \u0906\u092a\u0915\u093e \u092e\u094b\u0921 \u092e\u094b\u0921 \u0915\u093e"], [364, "\u092e\u0924\u0932\u092c \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u092b\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u0915\u093f \u0915\u093f\u0924\u0928\u0940"], [366, "\u092c\u093e\u0930 \u0906\u092a\u0915\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u091c\u094b \u0939\u0948 \u0935\u094b \u0905\u0915\u094d\u0915\u0930 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948"], [368, "\u092c\u093e\u0930-\u092c\u093e\u0930 \u091c\u0948\u0938\u0947 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0907\u0938 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0921\u093e\u091f\u093e"], [371, "\u0939\u0948 \u0924\u094b \u0907\u0938 \u0921\u093e\u091f\u093e \u092e\u0947\u0902 \u0926\u0947\u0916\u094b \u092f\u0939\u093e\u0902 \u092a\u0947 \u0925\u094d\u0930\u0940 \u091c\u094b"], [373, "\u0939\u0948 \u0935\u094b 1 \u0926\u094b \u0924\u0940\u0928 \u0924\u0940\u0928 \u092c\u093e\u0930 \u0905\u0915\u094d\u0915\u0930 \u0939\u0941\u0906 \u0939\u0948 \u0924\u094b"], [377, "\u0910\u0938\u0940 \u0915\u094c\u0928 \u0938\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u0939\u0948 \u091c\u094b \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092c\u093e\u0930"], [379, "\u0905\u0915\u0930 \u0939\u0941\u0908 \u0939\u0948 \u0925\u094d\u0930\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u0939\u0948 \u091c\u094b \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e"], [382, "\u092c\u093e\u0930 \u0905\u0915\u094d\u0915\u0930 \u0939\u0941\u0908 \u0939\u0948 \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u0905\u0915\u094d\u0915\u0930 \u0939\u0941\u0908 \u0939\u0948"], [383, "\u0925\u094d\u0930\u0940 \u091f\u093e\u0907\u092e \u0905\u0915\u0930 \u0939\u0941\u0908 \u0939\u0948 \u0924\u094b \u0907\u0938 \u0935\u091c\u0939 \u0938\u0947 \u0906\u092a \u0915\u0939"], [385, "\u0938\u0915\u0924\u0947 \u0939\u094b \u0915\u093f \u0907\u0938\u0915\u093e \u091c\u094b \u0939\u0948 \u0935\u094b \u092e\u094b\u0921 \u0915\u094d\u092f\u093e \u0939\u094b \u0917\u092f\u093e"], [388, "\u0925\u094d\u0930\u0940 \u0939\u094b \u0917\u092f\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0925\u094d\u0930\u0940 \u091c\u094b \u0939\u0948 \u0938\u092c\u0938\u0947"], [390, "\u091c\u094d\u092f\u093e\u0926\u093e \u092c\u093e\u0930 \u0905\u0915 \u0930\u0939\u0940 \u0939\u0948 \u0932\u0947\u091f\u094d\u0938 \u0938\u0947 \u0905\u0917\u0930 \u0906\u092a"], [392, "\u092f\u0939\u093e\u0902 \u0938\u0947 \u0925\u094d\u0930\u0940 \u0915\u094b \u0921\u093f\u0932\u0940\u091f \u0915\u0930 \u0926\u094b \u092f\u0939\u093e\u0902 \u0938\u0947 \u092d\u0940"], [394, "\u0925\u094d\u0930\u0940 \u0915\u094b \u0921\u093f\u0932\u0940\u091f \u0915\u0930 \u0926\u094b \u0905\u092c \u0906\u0908 \u0925\u093f\u0902\u0915 \u092e\u094b\u0921 \u091c\u094b \u0939\u0948"], [396, "\u0935\u094b \u0915\u0941\u091b \u092d\u0940 \u0928\u0939\u0940\u0902 \u0906\u090f\u0917\u093e \u0915\u094d\u092f\u094b\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0915\u094b\u0908 \u092d\u0940"], [399, "\u0910\u0938\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948 \u091c\u094b \u090f\u0915 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092c\u093e\u0930"], [401, "\u0930\u0915\u0930 \u0939\u0941\u0908 \u0939\u0948 \u0924\u094b \u0906\u092a \u0907\u0938 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0930"], [403, "\u0938\u0915\u0924\u0947 \u0939\u094b \u092f\u0939\u093e\u0902 \u092a\u0947 \u092d\u0940 \u0915\u0939\u0940\u0902 \u0928\u093e \u0915\u0939\u0940\u0902 \u0906\u092a\u0915\u094b"], [405, "\u0939\u0947\u0932\u094d\u092a \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u0908-\u0915\u0949\u092e\u0930\u094d\u0938 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924"], [407, "\u091c\u094d\u092f\u093e\u0926\u093e \u0915\u0902\u092a\u0928\u0940\u091c \u091c\u094b \u0939\u0948 \u0935\u094b \u092f\u0947 \u091a\u0940\u091c \u0926\u0947\u0916\u0924\u0940 \u0939\u0948\u0902"], [409, "\u0915\u093f \u0915\u094c\u0928 \u0938\u093e \u0910\u0938\u093e \u092c\u0902\u0926\u093e \u0939\u0948 \u091c\u094b \u092c\u093e\u0930-\u092c\u093e\u0930 \u091a\u0940\u091c\u0947\u0902"], [411, "\u0916\u0930\u0940\u0926 \u0930\u0939\u093e \u0939\u0948 \u0938\u0947\u092e \u0939\u0940 \u091f\u093e\u0907\u092a \u0915\u0940 \u091a\u0940\u091c\u0947\u0902 \u091c\u094b \u0939\u0948"], [414, "\u0935\u094b \u092c\u093e\u0930-\u092c\u093e\u0930 \u0916\u0930\u0940\u0926 \u0930\u0939\u093e \u0939\u0948 \u0924\u094b \u092b\u093f\u0930 \u0935\u094b \u0909\u0938\u0915\u094b"], [416, "\u0909\u0938\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u090f\u0921\u0935\u0930\u094d\u091f\u093e\u0907\u091c\u092e\u0947\u0902\u091f \u092f\u093e \u0911\u092b \u0935\u0917\u0948\u0930\u0939"], [419, "\u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0924\u093e\u0915\u093f \u0935\u094b \u092c\u0902\u0926\u093e \u0926\u094b\u092c\u093e\u0930\u093e \u0938\u0947 \u092b\u093f\u0930"], [421, "\u0916\u0930\u0940\u0926\u0947 \u092e\u0924\u0932\u092c \u0909\u0938\u0915\u093e \u0907\u0902\u0915\u094d\u0932\u093f\u0928\u0947\u0936\u0928 \u091c\u094b \u0939\u0948 \u0935\u094b \u091a\u0947\u0915"], [423, "\u0915\u0930 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0907\u0902\u091f\u0930\u0947\u0938\u094d\u091f \u0915\u094d\u092f\u093e \u0939\u0948 \u0924\u094b \u092f\u0947 \u092d\u0940"], [425, "\u0915\u0939\u0940\u0902 \u0928\u093e \u0915\u0939\u0940\u0902 \u0921\u093f\u0938\u0940\u091c\u0928 \u092e\u0947\u0915\u093f\u0902\u0917 \u092e\u0947\u0902 \u0939\u0947\u0932\u094d\u092a"], [427, "\u0915\u0930\u0924\u093e \u0939\u0948 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0906 \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u0940 \u0932\u093e\u0938\u094d\u091f \u0906\u092a\u0915\u093e"], [429, "\u0930\u0947\u0902\u091c \u0930\u0947\u0902\u091c \u0915\u093e \u092e\u0924\u0932\u092c \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0940"], [432, "\u0935\u0948\u0932\u094d\u092f\u0942 \u0915\u0939\u093e\u0902 \u0938\u0947 \u0932\u0947\u0915\u0947 \u0915\u0939\u093e\u0902 \u0924\u0915 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948"], [434, "\u0920\u0940\u0915 \u0939\u0948 \u091c\u0948\u0938\u0947 \u0939\u092e \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0928\u093e \u0932\u094b\u090f\u0938\u094d\u091f \u092a\u0948\u0915\u0947\u091c"], [435, "\u0907\u0924\u0928\u093e \u0939\u093e\u0908\u090f\u0938\u094d\u091f \u092a\u0948\u0915\u0947\u091c \u0907\u0924\u0928\u093e \u092e\u0924\u0932\u092c \u0915\u0939\u093e\u0902 \u0938\u0947"], [437, "\u0932\u0947\u0915\u0947 \u0915\u0939\u093e\u0902 \u0924\u0915 \u0906\u092a\u0915\u0940 \u0930\u0947\u0902\u091c \u091c\u094b \u0939\u0948 \u0935\u094b \u091c\u093e \u0930\u0939\u0940"], [439, "\u0939\u0948 \u0924\u094b \u0935\u094b \u0906\u092a \u0915\u0948\u0938\u0947 \u0915\u0948\u0932\u0915\u0941\u0932\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u094b \u0906\u092a\u0915\u0947"], [442, "\u092a\u093e\u0938 \u090f\u0915 \u092e\u093f\u0928\u093f\u092e\u092e \u0935\u0948\u0932\u094d\u092f\u0942 \u0939\u0948 \u090f\u0915 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0915\u094d\u092f\u093e"], [444, "\u0939\u0948 \u092e\u0948\u0915\u094d\u0938\u093f\u092e\u092e \u0935\u0948\u0932\u094d\u092f\u0942 \u0924\u094b \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u094b \u092e\u0948\u0915\u094d\u0938"], [446, "\u0935\u0948\u0932\u094d\u092f\u0942 \u092e\u093e\u0907\u0928\u0938 \u092e\u0947\u0928 \u0915\u0930 \u0926\u094b \u092f\u093e\u0928\u0940 30"], [450, "\u092e\u093e\u0907\u0928\u0938 2 \u0915\u0930\u094b\u0917\u0947 \u0924\u094b 30 \u092f\u093e\u0928\u0940 \u0930\u0947\u0902\u091c \u0915\u094d\u092f\u093e \u0939\u094b\u0917\u0940"], [453, "\u0907\u0938\u0915\u0940 30 \u0924\u094b \u092f\u0939 \u0938\u093f\u0902\u092a\u0932 \u0938\u093e \u092b\u0902\u0921 \u0939\u0948 \u0932\u0947\u0915\u093f\u0928"], [455, "\u0907\u0902\u092a\u0949\u0930\u094d\u091f\u0947\u0902\u091f \u0939\u0948 \u091b\u094b\u091f\u0947 \u091b\u094b\u091f\u0947 \u092a\u0949\u0907\u0902\u091f \u0938\u0947 \u0907\u0928\u0915\u094b"], [457, "\u0928\u094b\u091f \u0915\u0930 \u0932\u0947\u0928\u093e \u092f\u0939 \u092c\u093f\u0932\u094d\u0921\u093f\u0902\u0917 \u092c\u094d\u0932\u0949\u0915\u094d\u0938 \u0939\u0948 \u092e\u0936\u0940\u0928"], [459, "\u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0915\u0947 \u0925\u0948\u0902\u0915 \u092f"]]